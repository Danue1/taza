{
  "sourceLanguage": "ko",
  "strings": {
    "\".\" 단축키": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“.” Shortcut"
          }
        }
      }
    },
    "%@ 언어팩 다운로드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the %@ language pack"
