    },
    "App Group을 쓸 수 없어 언어팩을 설치할 자리가 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an app group there is nowhere to install language packs."
          }
        }
      }
    },
    "Taza 키보드 추가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
